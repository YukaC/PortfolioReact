{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Fullstack Developer portfolio built with Next.js, React, and a Cowboy Bebop–themed R3F easter egg.",
  "license": "MIT",
  "author": "Agustin Ciucani",
  "repository": {
    "type": "git",
    "url": "https://github.com/YukaC/PortfolioReact.git"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test src/lib/*.test.js",
    "test:all": "pnpm gate",
    "gate": "node scripts/gate.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:lint": "eslint .",
    "e2e:a11y": "node scripts/e2e-a11y.mjs",
    "e2e:functional": "node scripts/e2e-functional.mjs",
    "e2e:nojs": "node scripts/e2e-nojs.mjs",
    "e2e:runtime": "node scripts/e2e-runtime.mjs",
    "e2e:motion": "node scripts/e2e-footer-motion.mjs",
    "check:motion": "node scripts/check-motion-aliases.mjs",
    "measure:vitals": "node scripts/measure-vitals.mjs",
    "measure:idle": "node scripts/measure-idle.mjs",
    "measure:scroll": "node scripts/measure-scroll-perf.mjs",
    "visual:baseline": "node scripts/visual-baseline.mjs",
    "visual:diff": "node scripts/visual-diff.mjs",
    "validate:bebop": "node scripts/validate-bebop-timing.mjs",
    "perf": "bash scripts/perf-suite.sh",
    "perf:quick": "bash scripts/perf-suite.sh --quick",
    "perf:stress": "bash scripts/perf-suite.sh --stress",
    "perf:ablate": "bash scripts/perf-suite.sh --ablate"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "^16.4.5",
    "postprocessing": "^6.39.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.4"
  }
}
