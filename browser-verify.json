{
  "server": {
    "command": "pnpm dev",
    "port": 3000,
    "path": "/",
    "timeoutMs": 180000,
    "reuse": true
  },
  "viewports": [
    { "name": "desktop", "width": 1280, "height": 900 },
    { "name": "mobile", "width": 390, "height": 844 }
  ],
  "pages": [
    {
      "path": "/",
      "rules": [
        { "rule": "document", "lang": "en" },
        "h1",
        "img-alt",
        "anchors",
        "console",
        "first-tab",
        "a11y-labels",
        { "rule": "reduced-motion", "selector": "h1" },
        { "rule": "no-overflow", "viewport": "all" },
        { "rule": "visible", "selector": ".field-progress" },
        { "rule": "count", "selector": "[data-work-tab]", "min": 5 },
        { "rule": "count", "selector": "[data-work-row]", "min": 5 },
        { "rule": "text", "selector": ".marquee", "contains": "Next.js" },
        { "rule": "text", "selector": "#contact .bigmail", "contains": "@" },
        { "rule": "text", "selector": ".footer-mark", "contains": "CIUCANI" }

      ]
    }
  ]
}
